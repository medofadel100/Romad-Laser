rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if user is admin or staff
    function isStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    // Products: anyone can read active, only admin can write
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories: anyone can read, only admin can write
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: user can read own, admin/staff read all, anyone can create
    match /orders/{id} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isStaff()
      ) || resource.data.userId == null; // Allow guest order read with order ID
      allow create: if true; // Allow guest checkout
      allow update: if isStaff() ||
        (request.auth != null && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentScreenshot', 'paymentStatus', 'updatedAt']));
    }

    // Users: user can read/write own data, admin can read all
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'phone']);
    }

    // Reviews: anyone reads approved, auth users create, admin approves/rejects
    match /reviews/{id} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Coupons: authenticated users can read (to validate), only admin can write
    match /coupons/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
